# The API reads the three Postgres services. From the host, Nord is on 5435
# because a local Postgres often already listens on 5432.
DATA_MODE=postgres
HOSPITAL_NODES=Klinikum Nord=postgresql://hospital:hospital@localhost:5435/hospital;Klinikum Süd=postgresql://hospital:hospital@localhost:5433/hospital;Klinikum West=postgresql://hospital:hospital@localhost:5434/hospital

# Inside the api container the services keep port 5432:
# HOSPITAL_NODES=Klinikum Nord=postgresql://hospital:hospital@db_nord:5432/hospital;Klinikum Süd=postgresql://hospital:hospital@db_sud:5432/hospital;Klinikum West=postgresql://hospital:hospital@db_west:5432/hospital

# Required to read a request. The model classifies the purpose and builds the QuerySpec.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1
SESSION_SECRET=change-me
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

SEED_APPLICANT_USERNAME=applicant
SEED_APPLICANT_PASSWORD=applicant
SEED_STAFF_USERNAME=staff
SEED_STAFF_PASSWORD=staff
